# Docker Compose production settings; copy to .env, which is not committed.
# Use a long random URL-safe password (letters, digits, dash, underscore).
PLANNER_DB_PASSWORD=replace_with_a_long_random_password
# The ERP must verify the bearer token and return the documented identity JSON.
ERP_AUTH_URL=https://erp.example.com/internal/load-planner/identity
PLANNER_ALLOWED_ORIGINS=https://super-u-display.github.io,https://erp.example.com
